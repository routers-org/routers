{
  "title": "Routers Realtime",
  "uid": "routers-realtime",
  "version": 10,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "routers"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Flow",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Throughput (per second)",
      "description": "Each stage of the pipeline as a rate. Broker sequence rates are authoritative plane ingress; raw deliveries include retries, so gaps between publish, delivery, and ack expose queueing or redelivery amplification.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(nats_stream_last_seq{stream_name=~\"EVENTS-RAW-.*\"}[$__rate_interval]))",
          "legendFormat": "raw published",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(offered_observations_total[$__rate_interval]))",
          "legendFormat": "raw deliveries",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(raw_acks_total[$__rate_interval]))",
          "legendFormat": "raw acked",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(queued_observations_total[$__rate_interval]))",
          "legendFormat": "queued",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(jobs_claimed_total[$__rate_interval]))",
          "legendFormat": "jobs dispatched (app)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(nats_stream_last_seq{stream_name=~\"SOLVE-JOBS-.*\"}[$__rate_interval]))",
          "legendFormat": "jobs published (broker)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(nats_stream_last_seq{stream_name=\"SOLVE-RESULTS\"}[$__rate_interval]))",
          "legendFormat": "results published (broker)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(results_received_total[$__rate_interval]))",
          "legendFormat": "results received",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(completions_total[$__rate_interval]))",
          "legendFormat": "decisions committed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(nats_stream_last_seq{stream_name=\"EVENTS-MATCHED\"}[$__rate_interval]))",
          "legendFormat": "matched published (broker)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(rate(materialized_outputs_total[$__rate_interval]))",
          "legendFormat": "materialized",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "title": "Backlog",
      "description": "How far behind the pipeline is. Oldest pending is wall-clock lag after broker claim; the counts include scheduler, admission, and matcher pool occupancy.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest pending (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "max(oldest_pending_age_seconds)",
          "legendFormat": "oldest pending (s)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(pending_observations)",
          "legendFormat": "observations queued",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(active_jobs)",
          "legendFormat": "jobs in flight",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(vehicles_tracked)",
          "legendFormat": "vehicles tracked",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(jobs_outstanding)",
          "legendFormat": "permits outstanding",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(admission_waiting)",
          "legendFormat": "waiting for admission",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max(frontier_lag)",
          "legendFormat": "frontier lag (raw seqs)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(matcher_handlers_in_flight)",
          "legendFormat": "matcher handlers",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(matcher_solves_in_flight)",
          "legendFormat": "matcher solves",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "title": "Committed by outcome",
      "description": "Totals over the selected range.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(completions_total[$__range]))",
          "legendFormat": "{{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "title": "Match success",
      "description": "Matched commits over all commits in range.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(increase(completions_total{outcome=\"matched\"}[$__range])) / sum(increase(completions_total[$__range]))",
          "legendFormat": "success",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 6,
      "title": "Dropped",
      "description": "Raw messages, results and observations discarded in range.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(increase(poison_observations_total[$__range]))",
          "legendFormat": "poison raw",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(suppressed_observations_total[$__range]))",
          "legendFormat": "suppressed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(rejected_results_total[$__range]))",
          "legendFormat": "rejected results",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(quarantined_results_total[$__range]))",
          "legendFormat": "quarantined",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 7,
      "title": "Matchers ready",
      "description": "Replicas serving a usable graph, by region.",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 10,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum by (region) (graph_ready)",
          "legendFormat": "{{region}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 8,
      "title": "Solve",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "Solve time",
      "description": "Admitted matcher solve wall time and the wait for a CPU solve permit. Permit wait with full solve occupancy means CPU admission is working; solve time excludes that wait.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, region) (rate(solve_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{region}} p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, region) (rate(solve_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{region}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, region) (rate(solve_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{region}} solve p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, region) (rate(solve_permit_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{region}} permit wait p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, region) (rate(solve_permit_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{region}} permit wait p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 10,
      "title": "Queue wait",
      "description": "Broker residence before each stage claimed work. Raw wait identifies orchestrator ingress lag; solve wait identifies matcher lag. Redelivered solve claims are JetStream retries after ack_wait.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, delivery) (rate(queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{delivery}} p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, delivery) (rate(queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{delivery}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, delivery) (rate(queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "solve {{delivery}} p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(raw_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "raw p50",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(raw_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "raw p95",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(raw_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "raw p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 11,
      "title": "Message sizes",
      "description": "Encoded bytes of jobs, results and committed outputs. All three carry the trip; growth here is the trip not converging. Red line: 8 MiB broker limit.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",

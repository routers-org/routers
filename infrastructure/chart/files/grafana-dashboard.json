            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(result_bytes_bucket[$__rate_interval])))",
          "legendFormat": "result p99",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(output_bytes_bucket[$__rate_interval])))",
          "legendFormat": "output p99",
          "datasource": {

# Env overrides: ROUTERS_NAMESPACE, ROUTERS_VALUES, ROUTERS_SHARD_CACHE.
namespace := env("ROUTERS_NAMESPACE", "routers")
values := env("ROUTERS_VALUES", "values-local-dev.yaml")
shard-cache := env("ROUTERS_SHARD_CACHE", `cd .. && cd .. && pwd` + "/target/shard_cache")

install:
    @out=$(helm upgrade --install routers-realtime . -n {{ namespace }} --create-namespace 2>&1) || { echo "$out"; exit 1; }

# Full install layered with an environment-specific values file.
bringup:
    helm upgrade --install routers-realtime . \
        -n {{ namespace }} --create-namespace \
        -f {{ values }} \
        --set shardCache.hostPath={{ shard-cache }}

# Re-apply and roll workloads so configmap/env changes reach the pods.
patch:
    helm upgrade routers-realtime . \
        -n {{ namespace }} \
        -f {{ values }} \
        --set shardCache.hostPath={{ shard-cache }}
    kubectl rollout restart deployment,statefulset -n {{ namespace }}

# Uninstall; set ROUTERS_DELETE_NAMESPACE=1 to also drop the namespace.
teardown:
    helm uninstall routers-realtime -n {{ namespace }} --ignore-not-found
    @if [ "${ROUTERS_DELETE_NAMESPACE:-0}" = "1" ]; then \
        echo "Deleting namespace {{ namespace }}"; \
        kubectl delete namespace {{ namespace }} --ignore-not-found; \
    fi

# Use a PersistentVolumeClaim for shard cache.
use-pvc: install
    helm upgrade routers-realtime . \
        -n {{ namespace }} \
        --set shardCache.mode=pvc \
        --set shardCache.pvc.claimName=routers-shards

# Render just the region catalog the chart would mount, to eyeball the TOML.
show-catalog:
    helm template routers-realtime . -f {{ values }} -s templates/catalog-configmap.yaml

use-shard-cache cache-dir="": install
    helm upgrade routers-realtime . \
        -n {{ namespace }} \
        -f {{ values }} \
        --set 'shardCache.hostPath={{ cache-dir }}/target/shard_cache'

lint:
    helm lint .

# Package and push the chart to Artifact Registry as an OCI artifact.
publish registry version:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    helm package . --version {{ version }} --app-version {{ version }} -d "$dir" > /dev/null
    helm push "$dir/routers-realtime-{{ version }}.tgz" "oci://{{ registry }}/charts"
